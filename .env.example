# Adding property to determine the upper boundary of a 'slow' query - JSB
GORM_SLOW_THRESHOLD_MS=200

VITE_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Analytics is OFF unless VITE_DEPLOYMENT is set AND the key above is a real
# phc_-prefixed project key. Deployed images get these at build time; leave them
# blank for local development. To deliberately send from local, set
# VITE_DEPLOYMENT=local — every event is then tagged so it can be excluded in
# PostHog rather than mixed into facility data.
VITE_DEPLOYMENT=
VITE_STATE=

# Open Content (github.com/UnlockedLabs/unlocked-open-content) runs as its own
# service. `make dev` builds it straight from GitHub, so you need no checkout
# unless you're changing it. To build your own changes, set OPEN_CONTENT_DIR to
# your checkout, relative to this repo or absolute. To try another branch
# without a checkout, such as a PR's, set OPEN_CONTENT_REF (default main).
# OPEN_CONTENT_DIR=../unlocked-open-content
# OPEN_CONTENT_REF=main
# Provider Platforms (github.com/UnlockedLabs/unlocked-provider-platforms) is
# built the same way, with PROVIDER_PLATFORMS_DIR and PROVIDER_PLATFORMS_REF.
# PROVIDER_PLATFORMS_DIR=../unlocked-provider-platforms
# PROVIDER_PLATFORMS_REF=main
# Programs (github.com/UnlockedLabs/unlocked-programs) is built the same way,
# with PROGRAMS_DIR and PROGRAMS_REF.
# PROGRAMS_DIR=../unlocked-programs
# PROGRAMS_REF=main

# Path to the AI tutor checkout (github.com/UnlockedLabs/unlocked-hiset-ai),
# relative to this repo or absolute. Defaults to ../ai/unlocked-hiset-ai.
# Used by both `make dev` and the tutor-service build context.
# TUTOR_DIR=../ai/unlocked-hiset-ai
#
# Published tutor image tag when there is no local checkout. Defaults to `main`.
# The GHCR package is private: run `docker login ghcr.io` with a PAT that has
# read:packages, or the pull fails and the stack starts without the tutor.
# TUTOR_IMAGE_TAG=main

# AI tutor sidecar (docker-compose.yml tutor-service) — set one provider
# TUTOR_AI_PROVIDER=google
# GEMINI_API_KEY=your_gemini_api_key_here
# TUTOR_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Bedrock is the tutor's production provider. When USE_BEDROCK is set, ALL AI
# routes through AWS and TUTOR_AI_PROVIDER above is ignored. Leave it unset to
# keep using the API-key providers above — the stack does not require AWS.
# Model ids are cross-region inference profiles; see the tutor's
# lib/ai/client.ts. Real values go in .env, never here.
# USE_BEDROCK=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
